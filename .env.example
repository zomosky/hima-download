# JAXA P-Tree FTP credentials
HIMA_FTP_HOST=ftp.ptree.jaxa.jp
HIMA_FTP_USER=com
HIMA_FTP_PASS=****

# Local data root
HIMA_DATA_DIR=./data

# Concurrency (FTP server tolerates ~4-6 parallel connections)
HIMA_CONCURRENCY=4

# Products to download: comma-separated, choices: PAR, CLP, ARP
HIMA_PRODUCTS=PAR,CLP,ARP

# Minutes within each hour to download (mm of timeline). Default is 00 and 10 for redundancy.
HIMA_MINUTES=00,10

# Include 1km Japan-area PAR file? (rFL...). For China PV: leave false.
HIMA_PAR_INCLUDE_JAPAN=false

# Realtime polling window (hours back from now to scan each cycle)
HIMA_REALTIME_WINDOW_HOURS=6

# Realtime poll interval (seconds)
HIMA_REALTIME_INTERVAL_SEC=300

# Retry settings
HIMA_MAX_RETRIES=5
HIMA_RETRY_BACKOFF_SEC=10

# Log file (also writes to stderr). Rotation by size, retention by age.
HIMA_LOG_FILE=./logs/hima-download.log
HIMA_LOG_ROTATION=50 MB
HIMA_LOG_RETENTION=14 days
